{
  "name": "avr-ide",
  "version": "0.1.0",
  "description": "IDE for Arduino / ESP with ESPUI visual builder",
  "author": "serzh",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "build:cores": "node scripts/build-core-packs.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "predist": "node scripts/check-cores-bundle.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "predist:dir": "node scripts/check-cores-bundle.mjs",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "test:e2e": "node scripts/e2e/run.mjs",
    "test:e2e:full": "node scripts/e2e/run.mjs --full",
    "check:compile": "node --import ./src/renderer/src/uibuilder/tests/register.mjs scripts/compile-check.mts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  }
}
